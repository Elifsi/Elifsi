# Elifsi Technologies Private Limited — Environment Variables

# Resend API Key for sending transactional notifications and candidate auto-acknowledgements
RESEND_API_KEY=re_your_api_key_here

# Outbound sender email address (must be a verified domain in Resend)
RESEND_FROM=Elifsi Technologies <noreply@elifsi.com>

# Internal team inbox for receiving contact leads and inquiries
RESEND_NOTIFY_EMAIL=contact@elifsi.com

# Internal recruitment inbox for receiving job applications and resumes
RESEND_CAREERS_EMAIL=careers@elifsi.com

# Base URL for metadata / canonical URLs (e.g., https://www.elifsi.com)
NEXT_PUBLIC_SITE_URL=https://www.elifsi.com
